{
    "compilerOptions": {
        "declaration": true,
        "target": "es6",
        "lib": [
            "es7"
        ],
        "module": "commonjs",
        "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@schemeless/*": ["../*/dist"]
    }
  },
    "exclude": [
        "node_modules",
        "**/*.test.ts"
    ],
    "include": [
        "src/**/*.ts"
    ]
}
