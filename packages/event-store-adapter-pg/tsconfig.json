{
  "compilerOptions": {
    "declaration": true,
    "target": "es6",
    "lib": ["es7"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@schemeless/event-store-types": ["../event-store-types/dist/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "**/*.test.ts"],
  "include": ["src/**/*.ts"]
}
